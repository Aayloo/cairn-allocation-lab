{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aayloo.github.io/cairn-allocation-lab/configs/results.schema.json",
  "title": "Cairn public results",
  "type": "object",
  "required": [
    "contract_version",
    "market_data_through",
    "version",
    "base_currency",
    "cost_bps",
    "metrics",
    "latest_weights",
    "policy_weights",
    "risk_contribution",
    "annual_return_contribution",
    "signals",
    "yearly_returns",
    "risk_diagnostics",
    "attribution_summary",
    "contribution_groups",
    "yearly_returns_by_strategy"
  ],
  "properties": {
    "contract_version": {
      "const": "cairn-results-v3"
    },
    "base_currency": {
      "const": "HKD"
    },
    "cost_bps": {
      "type": "number",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "required": ["L1 SAA", "L1 TAA", "60/40", "Equal weight"]
    },
    "latest_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "policy_weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "risk_diagnostics": {
      "type": "object",
      "required": [
        "capital_hhi",
        "effective_capital_assets",
        "top3_capital_share",
        "risk_hhi_abs",
        "effective_risk_assets",
        "top3_risk_share_abs",
        "dominant_risk_asset",
        "dominant_risk_share",
        "negative_risk_assets",
        "risk_to_capital"
      ]
    },
    "attribution_summary": {
      "type": "object",
      "required": [
        "gross_contribution",
        "annual_cost",
        "net_arithmetic_return",
        "compounding_residual",
        "reconciled_cagr",
        "identity_error"
      ]
    }
  }
}
